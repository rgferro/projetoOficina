{
  "name": "autogestao-oficina-lavajato",
  "version": "3.3.0",
  "description": "AutoGestão ERP Automotivo Pro - PDV, Lava-Jato, Oficina & CRM",
  "author": "AutoGestão Software",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"node server-whatsapp.js\" \"next dev -p 3000\"",
    "build": "next build",
    "start": "concurrently -k \"node server-whatsapp.js\" \"next start -p 3000\"",
    "whatsapp": "node server-whatsapp.js",
    "keygen": "node tools/keygen.js",
    "electron:dev": "concurrently -k \"node server-whatsapp.js\" \"next dev -p 3000\" \"electron .\"",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "email:prospeccao": "node scripts/disparar_emails_leads_jf.js",
    "email:prospeccao:dry": "node scripts/disparar_emails_leads_jf.js --dry-run",
    "security:check": "node scripts/security_ai_monitor.js",
    "setup": "npm install && npx prisma generate && npx prisma db push && npx tsx prisma/seed.ts"
  },
  "build": {
    "appId": "com.autogestao.oficina",
    "productName": "AutoGestao Oficina ERP",
    "copyright": "Copyright © 2026 AutoGestão Software",
    "electronVersion": "31.3.1",
    "asar": true,
    "directories": {
      "output": "dist_desktop"
    },
    "asarUnpack": [
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/**/*",
      "prisma/**/*",
      "dev.db"
    ],
    "files": [
      ".next/**/*",
      "prisma/**/*",
      "public/**/*",
      "electron/**/*",
      "server-whatsapp.js",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AutoGestao Oficina"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "public/icon.png"
    }
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "6.7.24",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "date-fns": "^3.6.0",
    "driver.js": "^1.8.0",
    "lucide-react": "^0.441.0",
    "next": "^14.2.24",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "31.3.1",
    "electron-builder": "24.13.3",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "tar": "^7.5.21",
    "extract-zip": "^2.0.1",
    "postcss": "^8.4.49"
  }
}
